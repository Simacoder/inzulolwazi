{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["backend/**/*.mjs", "backend/**/*.d.ts", "ml/**/*.mjs", "eval/**/*.mjs", "tests/**/*.mjs", "scripts/**/*.mjs"]
}
